<mxfile host="Remedy Mesh"><diagram id="arch" name="Architecture"><mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="990" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Remedy Mesh&lt;/b&gt; — architecture on Google Cloud" style="fontFamily=Helvetica;text;html=1;fontSize=22;fontColor=#202124;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Multi-agent recall management: detect a failing remedy (“fix-the-fix”), verify it, negotiate replacement parts, confirm by live phone call, and get human approval." style="fontFamily=Helvetica;text;html=1;fontSize=12;fontColor=#5f6368;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c4" value="Users &amp;amp; outside world" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=0;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;fillColor=#f8f9fa;strokeColor=#dadce0;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="250" height="640" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Eleanor · Analyst&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;runs cases, proposes resolutions,&lt;br&gt;places supplier calls&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="210" height="76" as="geometry"/></mxCell><mxCell id="c6" value="" style="fontFamily=Helvetica;sketch=0;html=1;aspect=fixed;strokeColor=none;fillColor=#5f6368;shape=mxgraph.gcp2.users;" vertex="1" parent="1"><mxGeometry x="52" y="163" width="38" height="24" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;James · Approver&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;approves POs &amp;amp; escalations,&lt;br&gt;files the Part 573 report&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="210" height="76" as="geometry"/></mxCell><mxCell id="c8" value="" style="fontFamily=Helvetica;sketch=0;html=1;aspect=fixed;strokeColor=none;fillColor=#5f6368;shape=mxgraph.gcp2.users;" vertex="1" parent="1"><mxGeometry x="52" y="258" width="38" height="24" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Supplier&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;answers a real phone call&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;spacingLeft=58;" vertex="1" parent="1"><mxGeometry x="40" y="615" width="210" height="70" as="geometry"/></mxCell><mxCell id="c10" value="" style="fontFamily=Helvetica;sketch=0;html=1;aspect=fixed;strokeColor=none;fillColor=#5f6368;shape=mxgraph.gcp2.phone;" vertex="1" parent="1"><mxGeometry x="60" y="628" width="24" height="38" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Twilio Voice&lt;/b&gt; &lt;font color='#80868b'&gt;(external)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;outbound call + speech capture&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;fillColor=#fdf2f2;strokeColor=#e8a1a1;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="210" height="64" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Gmail SMTP&lt;/b&gt; &lt;font color='#80868b'&gt;(external)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;PO PDFs + Part 573 to the PO inbox&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;fillColor=#fef7e0;strokeColor=#f2c94c;" vertex="1" parent="1"><mxGeometry x="40" y="395" width="210" height="64" as="geometry"/></mxCell><mxCell id="c13" value="Google Cloud · project region us-central1" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=0;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=52;spacingTop=12;fillColor=#f1f3f4;strokeColor=#4285f4;strokeWidth=1.5;fontColor=#1a73e8;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="1380" height="860" as="geometry"/></mxCell><mxCell id="c14" value="Cloud Run · service &lt;i&gt;remedymesh&lt;/i&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=0;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=52;spacingTop=12;fillColor=#e8f0fe;strokeColor=#4285f4;fontColor=#174ea6;" vertex="1" parent="1"><mxGeometry x="335" y="145" width="400" height="520" as="geometry"/></mxCell><mxCell id="c15" value="" style="fontFamily=Helvetica;editableCssRules=.*;sketch=0;html=1;shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;fontStyle=1;fontColor=#5f6368;spacingTop=-4;image=data:image/svg+xml,;;" vertex="1" parent="1"><mxGeometry x="347" y="152" width="27.5" height="34.0" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Web app + FastAPI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;single-page UI, live agent timeline over SSE&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#aecbfa;" vertex="1" parent="1"><mxGeometry x="355" y="200" width="360" height="66" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Roles &amp;amp; approvals&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;Analyst proposes, Approver decides · nothing is sent without sign-off&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#aecbfa;" vertex="1" parent="1"><mxGeometry x="355" y="278" width="360" height="66" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;deterministic verdict from policy rules · allocation under the $128 ceiling · ledger&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#aecbfa;" vertex="1" parent="1"><mxGeometry x="355" y="356" width="360" height="66" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Agent connector&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;stream_query to each deployed agent · per-supplier session state · retry on 429 · time budgets · honest fallback&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#aecbfa;" vertex="1" parent="1"><mxGeometry x="355" y="434" width="360" height="66" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Voice webhook&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;places the call · each spoken reply → Call Understanding Agent&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#aecbfa;" vertex="1" parent="1"><mxGeometry x="355" y="512" width="360" height="66" as="geometry"/></mxCell><mxCell id="c21" value="Vertex AI Agent Engine · 8 ADK agents, each a managed service" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=0;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=52;spacingTop=12;fillColor=#e6f4ea;strokeColor=#34a853;fontColor=#137333;" vertex="1" parent="1"><mxGeometry x="800" y="145" width="520" height="640" as="geometry"/></mxCell><mxCell id="c22" value="" style="fontFamily=Helvetica;editableCssRules=.*;sketch=0;html=1;shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;fontStyle=1;fontColor=#5f6368;spacingTop=-4;image=data:image/svg+xml,;;" vertex="1" parent="1"><mxGeometry x="812" y="152" width="30.0" height="34.0" as="geometry"/></mxCell><mxCell id="c23" value="Layer 1 · Detect &amp;amp; verify" style="fontFamily=Helvetica;rounded=1;arcSize=4;html=1;fillColor=#ffffff;strokeColor=#ceead6;fontSize=11;fontStyle=1;fontColor=#137333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="818" y="198" width="484" height="210" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Evidence Interpreter&lt;/b&gt; &lt;font color='#80868b'&gt;· Gemini 2.5 Flash&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;turns raw complaints into structured evidence&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#34a853;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="830" y="222" width="460" height="46" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Remedy Investigator&lt;/b&gt; &lt;font color='#80868b'&gt;· Gemini 2.5 Pro&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;links complaints to remedied vehicles, lots and campaigns&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#34a853;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="830" y="276" width="460" height="46" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Verification Agent&lt;/b&gt; &lt;font color='#80868b'&gt;· Gemini 2.5 Pro&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;independently re-checks the reasoning · chases missing records&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#34a853;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="830" y="330" width="460" height="46" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Resolution Agent&lt;/b&gt; &lt;font color='#80868b'&gt;· Gemini 2.5 Flash&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;writes the reasoning for non-sourcing outcomes (escalate, monitor, dismiss)&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#4285f4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="830" y="420" width="460" height="46" as="geometry"/></mxCell><mxCell id="c28" value="Layer 2 · Source &amp;amp; negotiate" style="fontFamily=Helvetica;rounded=1;arcSize=4;html=1;fillColor=#ffffff;strokeColor=#feefc3;fontSize=11;fontStyle=1;fontColor=#b06000;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="818" y="478" width="484" height="210" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Supplier Offer Agent ×3&lt;/b&gt; &lt;font color='#80868b'&gt;· Gemini 2.5 Flash&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;one session per supplier (state-scoped) · quotes price &amp;amp; capacity&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#fbbc04;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="830" y="502" width="460" height="46" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;OEM Counter Agent&lt;/b&gt; &lt;font color='#80868b'&gt;· Gemini 2.5 Flash&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;counters each offer · never above the $128 ceiling&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#fbbc04;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="830" y="556" width="460" height="46" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Re-source Agent&lt;/b&gt; &lt;font color='#80868b'&gt;· Gemini 2.5 Flash&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;after a decline: re-quotes the balance and narrates the counter round&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#fbbc04;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="830" y="610" width="460" height="46" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Call Understanding Agent&lt;/b&gt; &lt;font color='#80868b'&gt;· Gemini 2.5 Flash&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;reads the supplier’s spoken reply on the live call&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#a142f4;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="830" y="722" width="460" height="46" as="geometry"/></mxCell><mxCell id="c33" value="Gemini on Vertex AI" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=0;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=52;spacingTop=12;fillColor=#ffffff;strokeColor=#4285f4;fontColor=#174ea6;" vertex="1" parent="1"><mxGeometry x="1350" y="145" width="315" height="190" as="geometry"/></mxCell><mxCell id="c34" value="" style="fontFamily=Helvetica;editableCssRules=.*;sketch=0;html=1;shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;fontStyle=1;fontColor=#5f6368;spacingTop=-4;image=data:image/svg+xml,;;" vertex="1" parent="1"><mxGeometry x="1362" y="152" width="30.0" height="34.0" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Gemini 2.5 Flash&lt;/b&gt; — high-volume interpretation&lt;br&gt;&lt;b&gt;Gemini 2.5 Pro&lt;/b&gt; — investigation &amp;amp; verification&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#5f6368'&gt;global endpoint · retry with backoff on 429 / 503&lt;/font&gt;" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#dadce0;fillColor=#ffffff;shadow=0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=10;verticalAlign=middle;strokeColor=#aecbfa;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1365" y="20